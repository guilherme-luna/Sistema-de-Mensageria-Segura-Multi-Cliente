# Copie para .env e ajuste. O .env não é versionado.
# Deixar uma variável vazia equivale a usar o valor padrão.
# Caminhos relativos partem da raiz do projeto.

# --- Servidor ---
# Interface onde o servidor escuta:
#   127.0.0.1 -> só esta máquina
#   0.0.0.0   -> aceita clientes de outras máquinas da rede
SERVER_BIND_HOST=127.0.0.1
SERVER_PORT=9000
MAX_CLIENTS=64
# Segundos para o cliente concluir o handshake antes de ser desconectado
HANDSHAKE_TIMEOUT=10
SERVER_KEY_PATH=certs/server.key
SERVER_CERT_PATH=certs/public/server.crt

# --- Cliente ---
# Endereço do servidor (IP da máquina do servidor se estiver em outra máquina)
SERVER_HOST=127.0.0.1
# Cópia do certificado gerado na máquina do servidor
PINNED_CERT_PATH=certs/public/server.crt

# --- Logs --- (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
